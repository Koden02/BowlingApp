# Build the React app
FROM node:20-alpine AS build
WORKDIR /web

COPY BowlingApp/ClientApp/package*.json ./
RUN npm ci

COPY BowlingApp/ClientApp/ ./
RUN npm run build

# Serve with nginx
FROM nginx:alpine
WORKDIR /usr/share/nginx/html

# nginx config (reverse proxy /api -> api)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# static files
COPY --from=build /web/dist/ ./

EXPOSE 80